# Template for /opt/callme/.env on the droplet. Copy, fill, `chmod 600 .env`.
# NEVER commit the filled file — .gitignore already excludes .env / .env.*.

# Public domain pointing (A record) at the droplet — Caddy gets its TLS cert for this.
DOMAIN=api.example.com

# Container image — set once; APP_TAG is rewritten by every CD deploy (git SHA).
APP_IMAGE=ghcr.io/<owner>/callme
APP_TAG=latest

# Postgres superuser password for the callme database (also used by the app).
# Generate: openssl rand -base64 24
DB_PASSWORD=

# JWT signing key — minimum 32 bytes, the app refuses to boot otherwise.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed by CORS (the CSKH/admin web console) — comma-separated,
# never "*". Mobile apps are unaffected by CORS.
CORS_ALLOWED_ORIGINS=https://admin.example.com

# SpeedSMS (CLAUDE.md §4.8) — token from https://connect.speedsms.vn
SPEEDSMS_ACCESS_TOKEN=
# 4 = shared "Notify" sender (works with free credit, no brandname registration).
# After the CallMe brandname clears the carriers: SPEEDSMS_SMS_TYPE=3 + SPEEDSMS_SENDER=CallMe
SPEEDSMS_SMS_TYPE=4
SPEEDSMS_SENDER=
